.cashier-amount-card {
  text-align: center;
  padding: 48rpx 24rpx;
}

.cashier-amount {
  font-size: 56rpx;
  font-weight: 700;
  color: #2f54eb;
  margin: 12rpx 0;
}

.cashier-order {
  margin-top: 8rpx;
  word-break: break-all;
}

.cashier-countdown {
  margin-top: 16rpx;
  color: #d46b08;
  font-size: 26rpx;
}

.cashier-method {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.cashier-method-active {
  border-color: #2f54eb;
  background: #eef2ff;
}

.cashier-method-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #d1d5db;
}

.cashier-method-check-on {
  border-color: #2f54eb;
  background: #2f54eb;
  box-shadow: inset 0 0 0 6rpx #fff;
}

.cashier-actions {
  padding: 10rpx 20rpx 40rpx;
}

.cashier-pay {
  width: 100%;
  margin-bottom: 16rpx;
}

.cashier-cancel {
  width: 100%;
}
