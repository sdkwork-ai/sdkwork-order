<view class="page-payment-result">
  <view class="result-hero result-hero-{{tone}}">
    <view class="result-icon result-icon-{{tone}}"></view>
    <view class="result-title">{{title}}</view>
    <view class="result-desc">{{description}}</view>
    <view class="result-meta" wx:if="{{orderId}}">单号：{{orderId}}</view>
    <view class="result-meta" wx:if="{{paymentId}}">支付单号：{{paymentId}}</view>
    <view wx:if="{{loading}}" class="mp-loading">查询支付结果...</view>
  </view>

  <view class="result-actions">
    <button
      wx:if="{{mode === 'recharge'}}"
      class="mp-btn mp-btn-primary result-action"
      bindtap="goRecharge"
    >返回充值</button>
    <button wx:else class="mp-btn mp-btn-primary result-action" bindtap="goOrders">查看订单</button>
    <button
      wx:if="{{status === 'failed' || status === 'expired'}}"
      class="mp-btn mp-btn-ghost result-action"
      bindtap="retryPay"
    >重新支付</button>
  </view>
</view>
