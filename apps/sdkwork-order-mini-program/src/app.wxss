page {
  background: #f4f5f7;
  color: #1f2937;
  font-size: 28rpx;
}

/* ── shared building blocks ── */
.mp-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
}

.mp-card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.mp-flex {
  display: flex;
  align-items: center;
}

.mp-flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mp-muted {
  color: #6b7280;
  font-size: 24rpx;
}

.mp-price {
  color: #2f54eb;
  font-weight: 700;
}

.mp-btn {
  border-radius: 999rpx;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  line-height: 1.5;
  text-align: center;
}

.mp-btn-primary {
  background: #2f54eb;
  color: #fff;
}

.mp-btn-primary[disabled] {
  background: #a5b8fc;
  color: #fff;
}

.mp-btn-ghost {
  background: #fff;
  color: #374151;
  border: 1rpx solid #d1d5db;
}

.mp-btn-plain {
  background: #eef2ff;
  color: #2f54eb;
}

.mp-empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
}

.mp-loading {
  padding: 40rpx;
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
}

.mp-error {
  margin: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 24rpx;
}

/* rows */
.mp-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

/* form */
.mp-field {
  display: block;
  margin-bottom: 24rpx;
}

.mp-field-label {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.mp-field input,
.mp-field textarea,
.mp-field picker {
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  background: #fff;
  width: 100%;
  box-sizing: border-box;
}

/* segmented control */
.mp-segment {
  display: flex;
  background: #e5e7eb;
  border-radius: 12rpx;
  margin: 20rpx;
  padding: 6rpx;
}

.mp-segment-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #4b5563;
  border-radius: 10rpx;
}

.mp-segment-item-active {
  background: #fff;
  color: #2f54eb;
  font-weight: 600;
}
