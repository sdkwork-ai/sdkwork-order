# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_order_demo` (table
# prefix `commerce_`) and a dedicated Redis logical DB index so that no cache key (rate-limit,
# session, idempotency) ever collides with another shared-redis environment.
SDKWORK_ORDER_DEPLOYMENT_PROFILE=standalone
SDKWORK_ORDER_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_ORDER_PROFILE_ID=standalone.demo
SDKWORK_ORDER_APPLICATION_PUBLIC_HTTP_URL=https://order-demo.sdkwork.com
