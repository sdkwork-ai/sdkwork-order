# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_order_demo` (table
# prefix `commerce_`) and a dedicated Redis logical DB index so no cache key collides with another
# shared-redis environment.
SDKWORK_ORDER_DEPLOYMENT_PROFILE=cloud
SDKWORK_ORDER_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_ORDER_PROFILE_ID=cloud.demo
SDKWORK_ORDER_APPLICATION_PUBLIC_HTTP_URL=https://order-demo.sdkwork.com
SDKWORK_ORDER_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_ORDER_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://order-demo.sdkwork.com,http://order-demo.sdkwork.com,https://order-demo.birdcoder.com,http://order-demo.birdcoder.com,https://order-demo.dtupay.com,http://order-demo.dtupay.com,https://order-demo.noaper.com,http://order-demo.noaper.com,https://order-demo.sdkwork.cn,http://order-demo.sdkwork.cn,https://order-demo.birdcoder.cn,http://order-demo.birdcoder.cn,https://order-demo.dtupay.cn,http://order-demo.dtupay.cn,https://order-demo.noaper.cn,http://order-demo.noaper.cn,https://order-demo.skubc.com,http://order-demo.skubc.com,https://order-demo.skubc.cn,http://order-demo.skubc.cn,https://order-demo.zowalk.com,http://order-demo.zowalk.com,https://order-demo.zowalk.cn,http://order-demo.zowalk.cn,https://order-demo.offer86.com,http://order-demo.offer86.com,https://order-demo.offer86.cn,http://order-demo.offer86.cn,https://order-demo.86offer.com,http://order-demo.86offer.com,https://order-demo.86offer.cn,http://order-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
