{
  "schemaVersion": 1,
  "kind": "sdkwork.commerce.order.payment-webhook",
  "capability": "order",
  "domain": "commerce",
  "role": "payment-webhook-orchestrator",
  "dependencyDirection": "order -> payment (in-process PaymentWebhookStore + payment-providers lib); payment -X-> order",
  "ownedRoutes": {
    "app": [
      "POST /app/v3/api/orders/payments/webhooks/{providerCode}"
    ],
    "backend": [
      "POST /backend/v3/api/orders/{orderId}/payment_confirmations"
    ]
  },
  "deprecatedRoutes": {
    "paymentApp": [
      "POST /app/v3/api/payments/webhooks/{providerCode}"
    ],
    "paymentBackend": [
      "POST /backend/v3/api/payments/owner-orders/{orderId}/confirmations"
    ],
    "replacement": "order-app-api webhook + order-backend-api payment_confirmations"
  },
  "orchestrationSteps": [
    "resolve_provider_account",
    "verify_webhook_signature",
    "normalize_provider_event",
    "payment.ingest_provider_webhook",
    "load_order_subject",
    "applied_status dispatch (order.payment_notify building block)",
    "succeeded -> settle_owner_order_after_payment_success_with_registry",
    "failed/canceled/closed -> mark_owner_order_payment_failed (idempotent, terminal-safe)",
    "unmapped -> audit warn + accepted ack (no PSP retry storm)"
  ],
  "compensationWorker": {
    "owner": "sdkwork-order-service-host compensation.rs (spawn_payment_compensation_worker)",
    "role": "webhook 失败补偿：认领 pending/processing 支付与 submitted/processing 退款，查询 PSP 状态，以合成事件（query:{provider}:{out_trade_no}:{mapped_status}）复用 notify 积木（幂等/终态保护/履约键）",
    "env": "SDKWORK_ORDER_PAYMENT_COMPENSATION_WORKER_ENABLED（默认关闭）等，见 TECH_ARCHITECTURE.md §9",
    "idempotency": "合成事件与 webhook 重发同路径：ingest (tenant_id, provider_scoped_event_id) 去重 + 状态机 FOR UPDATE + 履约键；webhook 已成功时 worker 查询成为重放，无重复成功"
  },
  "notifyBuildingBlock": {
    "spec": "crates/sdkwork-order-service/specs/payment-notify.spec.json",
    "entrypoint": "process_payment_notify",
    "extension": "PaymentNotifyHandler + PaymentNotifyHandlerRegistry (register-only, pipeline unchanged)"
  },
  "successProcessing": {
    "entrypoint": "settle_owner_order_after_payment_success",
    "notificationSource": "verified webhook -> persisted exact payment attempt",
    "reconciliationSource": "provider query -> verified exact payment attempt",
    "transactionRule": "provider I/O happens before the database transaction; exact attempt confirmation uses conditional transactional writes and idempotent replay",
    "supportedProviders": [
      "wechat_pay",
      "alipay",
      "stripe"
    ]
  },
  "paymentPort": {
    "crate": "sdkwork-payment-repository-sqlx",
    "operations": [
      "ingest_provider_webhook_postgres",
      "confirm_owner_order_payment"
    ],
    "forbiddenInPayment": [
      "HTTP callback to order",
      "JOIN commerce_order",
      "settle_owner_order_after_payment_success"
    ]
  },
  "environment": {
    "webhookBaseUrlEnv": "ORDER_PAYMENT_WEBHOOK_BASE_URL",
    "webhookPathPattern": "{base}/app/v3/api/orders/payments/webhooks/{providerCode}",
    "legacyPaymentWebhookReturns": "410 Gone with migration ProblemDetail"
  },
  "forbidden": [
    "PSP webhook HTTP handlers in sdkwork-payment (except deprecated 410 shim)",
    "Payment → Order HTTP fulfillment client",
    "SDKWORK_PAYMENT_ORDER_SERVICE_AUTH_TOKEN"
  ]
}
